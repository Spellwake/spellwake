{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true, "noImplicitReturns": true,
    "isolatedModules": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "resolveJsonModule": true, "noEmit": true
  },
  "include": ["src", "../../packages/ui/src"]
}
