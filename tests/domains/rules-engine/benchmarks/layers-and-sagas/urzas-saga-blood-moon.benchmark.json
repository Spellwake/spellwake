  "rules_edition": {
    "edition": "2026-09-25",
    "source_url": "https://media.wizards.com/2026/downloads/MagicCompRules%2020260925.txt",
    "cited_rules": [
      {
        "rule": "305.7",
        "summary": "Setting a land's subtype to a basic land type (Mountain) removes abilities generated from its rules text and old land types and grants the matching basic mana ability, while preserving non-land types/subtypes (Enchantment, Saga) and abilities granted by other effects."
      },
      {
        "rule": "505.4",
        "summary": "At the beginning of the active player's precombat main phase, that player puts a lore counter on each Saga they control with one or more chapter abilities (turn-based action, does not use the stack)."
      },
      {
        "rule": "613.1d",
        "summary": "Layer 4 applies type-changing effects (including Blood Moon turning nonbasic lands into Mountains)."
      },
      {
        "rule": "613.1f",
        "summary": "Layer 6 applies ability-adding and ability-removing effects (including Urza's Saga Chapter I and II continuous effects granting activated abilities), after Layer 4."
      },
      {
        "rule": "614.12",
        "summary": "ETB replacement effects check characteristics as the permanent would exist on the battlefield under active continuous effects."
      },
      {
        "rule": "704.5s",
        "summary": "State-based action: a Saga permanent with one or more chapter abilities and lore counters >= final chapter number (with no chapter ability on the stack) is sacrificed."
      },
      {
        "rule": "714.2d",
        "summary": "A Saga's final chapter number is the greatest chapter symbol it has, or 0 if it has no chapter abilities."
      },
      {
        "rule": "714.3a",
        "summary": "Each Saga without read ahead has the intrinsic ability 'This Saga enters with a lore counter on it' (a replacement effect tied to the Saga subtype)."
      },
      {
        "rule": "714.3c",
        "summary": "As a player's precombat main phase begins, that player puts a lore counter on each Saga they control with one or more chapter abilities."
      },
      {
        "rule": "714.4",
        "summary": "Post-Final Fantasy Saga sacrifice rule: only a Saga permanent with one or more chapter abilities is sacrificed when lore counters >= final chapter number and no chapter ability from it is on the stack."
      }
    ]
  },
  "provenance": {
    "source_summary": "Derived from the Final Fantasy MTG Comprehensive Rules Saga update (CR 505.4, 704.5s, 714.3a, 714.3c, 714.4) and Layer 4/6 ordering (CR 305.7, 613.1d, 613.1f), inspired by community analysis of Urza's Saga + Blood Moon in Modern and Legacy.",
    "scope_notes": "Preemptive declarative benchmark authored before full Saga execution and Blood Moon continuous-effect integration land in crates/engine. Cards use exact Scryfall Oracle IDs and Oracle text verified against Spellwake fixtures and Scryfall."
  },
