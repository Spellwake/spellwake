      "unqualifiedReason": null,
      "relatedPaths": [
        "services/application/src/social.rs",
        "apps/play/src/data/social-api.test.ts",
        "apps/play/src/data/social-journal.test.ts",
        "apps/play/scripts/qualify-social.ts"
      ]
    },
    {
      "slug": "read-receipts-and-notifications",
      "label": "Read Receipts & Match Chat",
