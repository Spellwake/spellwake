  "checks": {
    "rust": [
      {
        "kind": "cargo",
        "label": "application social and contact lib tests",
        "args": [
          "cargo",
          "test",
          "--locked",
          "--manifest-path",
          "services/application/Cargo.toml",
          "--lib",
          "social"
        ],
        "cwd": ".",
        "envExtra": {}
      },
      {
        "kind": "cargo",
        "label": "application notifications lib tests",
        "args": [
          "cargo",
          "test",
          "--locked",
          "--manifest-path",
          "services/application/Cargo.toml",
          "--lib",
          "notifications"
        ],
        "cwd": ".",
        "envExtra": {}
      }
    ],
    "postgresDbFilters": [
      "chat_notifications_api",
      "game_chat_integrity",
      "game_message_integrity",
      "social",
      "social_commands",
      "social_read_ack",
      "social_reads"
    ],
    "frontend": [
      {
        "kind": "bun",
        "label": "play social, social API, and social journal unit tests",
        "args": [
          "bun",
          "test",
          "apps/play/src/data/social.test.ts",
          "apps/play/src/data/social-api.test.ts",
          "apps/play/src/data/social-journal.test.ts",
          "apps/play/src/messaging/updates.test.ts"
        ],
        "cwd": ".",
        "envExtra": {}
      }
    ],
    "browserE2e": [
      {
        "kind": "playwright",
