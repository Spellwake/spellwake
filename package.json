{
  "name": "spellwake-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "benchmarks/browser-rendering"
  ],
  "scripts": {
    "dev": "bun run app:dev",
    "build": "bun run app:build",
    "tauri": "tauri",
    "app:dev": "bun apps/play/scripts/tauri.ts dev",
    "app:build": "CI=true tauri build",
    "app:check": "bun run app:icons && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "app:icons": "bun apps/play/scripts/generate-icons.ts",
    "app:frontend:dev": "bun run --cwd apps/play dev --mode tauri",
    "app:frontend:build": "bun run app:icons && bun run play:check && bun run --cwd apps/play build --mode tauri",
    "play:dev": "bun run --cwd apps/play dev",
    "play:build": "bun run --cwd apps/play build",
    "play:check": "bun run --cwd apps/play check",
    "play:test": "bun test ./benchmarks/browser-rendering/src/*.test.ts ./packages/application-contracts/src/custom-cards.test.ts ./apps/play/src/cosmetics/*.test.ts ./apps/play/src/custom-cards/*.test.ts ./apps/play/src/collection/data/*.test.ts ./apps/play/src/data/*.test.ts ./apps/play/src/league/*.test.ts ./apps/play/src/match/*.test.ts ./apps/play/src/messaging/*.test.ts ./apps/play/src/play/*.test.ts ./packages/deck-box/src/*.test.ts ./packages/booster-pack/src/*.test.ts",
    "play:verify": "bun run play:check && bun run play:test && bun run play:build",
    "play:qualify-frame": "bun apps/play/scripts/qualify-frame.ts",
    "play:qualify-account": "bun apps/play/scripts/qualify-account.ts",
    "play:qualify-patreon": "node apps/play/scripts/qualify-patreon.ts",
    "play:qualify-stripe": "node apps/play/scripts/qualify-stripe.ts",
    "play:qualify-matchmaking": "node apps/play/scripts/qualify-matchmaking.ts",
    "play:qualify-predictions": "node apps/play/scripts/qualify-predictions.ts",
    "play:qualify-market": "node apps/play/scripts/qualify-market.ts",
    "play:qualify-auth": "node apps/play/scripts/qualify-auth.ts",
    "play:qualify-collection": "node apps/play/scripts/qualify-collection.ts",
    "play:qualify-custom-cards": "node apps/play/scripts/qualify-custom-cards.ts",
    "play:qualify-social": "node apps/play/scripts/qualify-social.ts",
    "play:qualify-league": "node apps/play/scripts/qualify-league.ts",
    "play:qualify-responsive": "node apps/play/scripts/qualify-responsive.ts",
    "play:qualify-3d": "node apps/play/scripts/qualify-3d.ts",
    "controls:smoke": "node apps/control-gallery/scripts/qualify-gallery.ts",
    "app:ios:init": "bun apps/play/scripts/prepare-mobile.ts ios",
    "app:ios:dev": "bun apps/play/scripts/tauri.ts ios dev",
    "app:ios:build": "tauri ios build",
    "app:android:init": "bun apps/play/scripts/prepare-mobile.ts android",
    "app:android:dev": "bun apps/play/scripts/tauri.ts android dev",
    "app:android:build": "tauri android build",
    "release:config": "bun apps/play/scripts/release-config.ts",
    "web:build": "bun run --cwd apps/play build --mode web && bun apps/play/scripts/web-manifest.ts",
    "release:test": "bun test apps/play/scripts/release-preflight.test.ts",
    "release:assets": "bun apps/play/scripts/fetch-release-assets.ts",
    "web:release:check": "bun apps/play/scripts/public-web-check.ts",
    "controls:build": "bun run --cwd apps/control-gallery build",
    "controls:check": "bun run --cwd apps/control-gallery check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
